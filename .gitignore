.DS_Store

# Vim generated state and installed plugins
vim/autoload/
vim/plugged/
vim/undo/
*.swp
*.swo

# tmux installed plugins and restored sessions
tmux/plugins/
tmux/resurrect/

# Local shell overrides may contain machine-specific values or secrets
.zshrc.local

# Codex writes backups next to its config; the live config lives in ~/.codex
codex/*.bak
